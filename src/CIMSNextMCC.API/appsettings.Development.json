{
  "Identity": {
    "Authority": "https://localhost:7001",
    "Audience": "cims-nextmcc-api",
    "RequiredScope": "cims.nextmcc",
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Authorization": {
    "LogOnly": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Authentication": {
    "Schemes": {
      "DevJwt": {
        "ValidAudiences": [
          "cims-nextmcc-api"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}

{
  "ConnectionStrings": {},
  "Identity": {
    "Authority": "https://localhost:7001",
    "Audience": "cims-nextmcc-api",
    "RequiredScope": "cims.nextmcc",
    "RequireHttpsMetadata": false
  },
  "Tenants": [
    {
      "Key": "NextMCC",
      "DisplayName": "Next MCC",
      "ConnectionStrings": { "Main": "", "Cfs": "", "Air": "", "Sea": "" }
    },
    {
      "Key": "NextCFS",
      "DisplayName": "Next CFS",
      "ConnectionStrings": { "Main": "", "Cfs": "", "Air": "", "Sea": "" }
    }
  ],
  "Cors": {
    "AllowedOrigins": []
  },
  "LegacyBridge": {
    "SharedKeyRingPath": "C:\\ProgramData\\CIMS\\keys",
    "CookieName": ".AspNet.ApplicationCookie",
    "ApplicationName": "CIMS_NextMCC",
    "ExpiryHours": 24
  },
  "Authorization": {
    "LogOnly": true
  },
  "EnableSwagger": false,
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cims-nextmcc-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "CIMSNextMCC.API"
    }
  },
  "AllowedHosts": "*"
}

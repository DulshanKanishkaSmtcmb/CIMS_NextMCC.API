<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the legacy cookie bridge (docs/09 section 4.3). Delete with the bridge in Phase 4. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The Katana packages target .NET Framework only; they are used here just to run the legacy app's ticket
         serializer (Microsoft.Owin.Security.Interop) in-process against the ASP.NET Core one. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Owin.Security" />
    <PackageReference Include="Microsoft.Owin.Security.Interop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CIMSNextMCC.API\CIMSNextMCC.API.csproj" />
    <ProjectReference Include="..\..\src\CIMSNextMCC.Domain\CIMSNextMCC.Domain.csproj" />
    <ProjectReference Include="..\..\src\CIMSNextMCC.Infrastructure\CIMSNextMCC.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

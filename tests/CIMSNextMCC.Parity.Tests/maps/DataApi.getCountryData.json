{
  // Legacy DataApi/getCountryData -> GET api/v1/master-data/countries/{code}   (Country master page, legacy docs/15)
  "legacy": { "controller": "DataApi", "action": "getCountryData", "method": "GET" },
  "status": "ported",
  "new": { "method": "GET", "route": "api/v1/master-data/countries/{code}" },

  // strData=[{"CountryCode":"IND","strRtnPara":"[]"}] (the existence check also sends "strCodeType":"Code", which is ignored).
  "queryJson": { "strData": { "CountryCode": "code", "strRtnPara": null, "strCodeType": null } },

  "legacyShape": { "kind": "dataRtnCls", "tables": [ "dtMain" ] },
  // The new endpoint returns one object, or 404 when the code does not exist (legacy: an empty table).
  "newShape": { "kind": "rows", "rowsPaths": [ "" ], "singleRow": true },

  "options": {},

  "notes": "An empty code cannot be replayed (an empty route segment is the list endpoint); the page never sends one."
}
